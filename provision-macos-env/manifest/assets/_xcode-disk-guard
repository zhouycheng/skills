#compdef xcode-disk-guard
# zsh 补全定义：xcode-disk-guard
# 位置：~/.local/share/zsh/site-functions/_xcode-disk-guard
# 依赖：~/.zshrc 中需启用 compinit 并把该目录加入 fpath

_xcode-disk-guard() {
  local -a subcmds
  subcmds=(
    'status:只读体检：现状、体积、是否已重定向'
    'top:只读：按体积列出最大的占用者'
    'redirect:把可丢弃数据迁移到 ~/Cache.localized/Xcode 并建立符号链接'
    'undo:撤销迁移，把目录原样搬回原位'
    'prune:清理超过阈值天数未使用与已失效的模拟器运行时'
    'help:显示用法'
  )

  _arguments -C \
    '(-h --help)'{-h,--help}'[显示用法]' \
    '--apply[真正执行；不加此参数时全程只读预览]' \
    '1: :->subcmd' \
    '*:: :->args'

  case $state in
    subcmd)
      _describe -t commands 'xcode-disk-guard 子命令' subcmds
      ;;
    args)
      case ${words[1]} in
        redirect|undo|prune)
          _arguments '--apply[真正执行；不加此参数时全程只读预览]'
          ;;
      esac
      ;;
  esac
}

_xcode-disk-guard "$@"
